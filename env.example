# Copy this file to ".env" (same folder) and fill in your key to go LIVE.
# Without a key, the app runs in free DEMO mode with a built-in sample.

# Your Claude API key (get one at https://console.anthropic.com).
# This is YOUR key. Customers never see it. You meter their runs and bill them.
ANTHROPIC_API_KEY=

# Optional. Model used for prospecting. Default is claude-sonnet-5 (good value).
# Use claude-opus-4-8 for harder runs.
PROSPECT_MODEL=claude-sonnet-5

# Optional. Cap runs per customer per calendar month (the subscription hook).
# 0 or unset = unlimited.
MONTHLY_RUN_LIMIT=0

# Optional. Port for the local web app.
PORT=5000
